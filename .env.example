# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then configure either Gemini (recommended here) or OpenAI.
GEMINI_API_KEY=your_gemini_api_key_here
# A comma-separated list lets the generator fail over on model-specific 429s.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional OpenAI fallback when GEMINI_API_KEY is not set.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
